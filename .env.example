# App
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USE_POLLING=false

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (Upstash) — HTTPS REST URL + token (@upstash/redis).
# Alias env names: UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# BullMQ Redis (must be redis:// or rediss:// for queue workers)
# If omitted, falls back to UPSTASH_REDIS_URL/TOKEN.
BULLMQ_REDIS_URL=
BULLMQ_REDIS_TOKEN=

# AI (Anthropic)
ANTHROPIC_API_KEY=

# Stripe
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Calendar
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_TIMEZONE=UTC

# Email (Resend)
RESEND_ENABLED=false
RESEND_API_KEY=

# Admin
ADMIN_TELEGRAM_IDS=123456789
ADMIN_ALERT_CHANNEL_ID=

